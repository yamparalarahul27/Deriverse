# =====================================================
# Deriverse — environment variables
# Copy to .env.local and fill in real values for local dev.
# .env.local is gitignored; never commit it.
# =====================================================

# App URL (used for SEO/links). Defaults to https://deriverse.app.
NEXT_PUBLIC_APP_URL=

# Solana program (devnet). Public on-chain identifier.
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_DERIVERSE_VERSION=

# RPC. Optional — falls back to https://api.devnet.solana.com if unset.
# If you have a Helius/QuickNode/etc. key, use a SERVER-ONLY proxy instead of
# exposing it via NEXT_PUBLIC_*. Anything with NEXT_PUBLIC_ ships to the browser.
NEXT_PUBLIC_HELIUS_RPC_URL=
NEXT_PUBLIC_RPC_HTTP=
NEXT_PUBLIC_RPC_DEVNET=
NEXT_PUBLIC_RPC_MAINNET=
NEXT_PUBLIC_WALLET_CLUSTER=devnet

# Supabase. Anon key is public-safe ONLY when RLS is enabled and policies
# scope every row by wallet/auth context. Verify in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
